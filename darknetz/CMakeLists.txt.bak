project (darknetp C)

# [추가됨 1] OP-TEE Client 경로 설정 (본인 경로로 수정 확인!)
set(OPTEE_CLIENT_PATH "/home/cheonsh/Linux_for_Tegra/public_sources/Linux_for_Tegra/source/public/nvidia-jetson-optee-source/optee/install/t194/usr/include/")

set(THREADS_PREFER_PTHREAD_FLAG ON)

set( THREADS_PTHREAD_ARG 
     "0"
     CACHE STRING "Result from TRY_RUN" FORCE)

find_package(Threads REQUIRED)

FILE(GLOB SRC host/src/*.c)
FILE(GLOB EXAM host/examples/*.c)
set(MAIN host/main.c)

add_executable (${PROJECT_NAME} ${SRC} ${EXAM} ${MAIN})

target_include_directories(${PROJECT_NAME}
				 PRIVATE host/include
				 PRIVATE host/src
				 PRIVATE include)

target_link_libraries (${PROJECT_NAME} PRIVATE teec -lm Threads::Threads)

install (TARGETS ${PROJECT_NAME} DESTINATION ${CMAKE_INSTALL_BINDIR})
